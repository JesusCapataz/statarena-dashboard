# ---- App ----
NODE_ENV=development
PORT=3001
# Allowlist CORS (coma-separado). En prod, dominios reales.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=statarena
DB_PASSWORD=change_me_in_prod
DB_NAME=statarena
# Solo en desarrollo: TypeORM crea el esquema automáticamente
DB_SYNCHRONIZE=true

# ---- Redis (cache + pub/sub) ----
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_SECONDS=60

# ---- Auth ----
# Genera uno fuerte: openssl rand -hex 48
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# ---- Proveedor de datos ----
# Elige proveedor:
#   apifootball  -> API-Football (fotos reales; en FREE solo temporadas 2021-2023)
#   footballdata -> football-data.org (TEMPORADA ACTUAL gratis; sin fotos de jugador)
PROVIDER=apifootball

# API-Football (https://www.api-football.com/)
APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io
APIFOOTBALL_KEY=your_api_football_key

# football-data.org (token gratis en https://www.football-data.org/client/register)
FOOTBALLDATA_BASE_URL=https://api.football-data.org/v4
FOOTBALLDATA_TOKEN=

# Temporada por defecto (API-Football) y ligas a sincronizar (ids estilo API-Football)
DEFAULT_SEASON=2024
SYNC_LEAGUE_IDS=140,39,135,78
# Frecuencia de sincronización en vivo (segundos)
LIVE_POLL_SECONDS=20
